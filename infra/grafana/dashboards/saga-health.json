{
  "uid": "outbox-arena-saga-health",
  "title": "outbox-arena -- Saga Health",
  "tags": ["outbox-arena", "saga"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "type": "stat",
      "title": "Sagas in-flight",
      "id": 1,
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "targets": [
        {"expr": "saga_inflight_count", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}}}
    },
    {
      "type": "stat",
      "title": "Completed (rate / 5m)",
      "id": 2,
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "targets": [
        {"expr": "sum(rate(saga_completed_total{outcome=\"completed\"}[5m]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    },
    {
      "type": "stat",
      "title": "Cancelled (rate / 5m)",
      "id": 3,
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "targets": [
        {"expr": "sum(rate(saga_completed_total{outcome=\"cancelled\"}[5m]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    },
    {
      "type": "stat",
      "title": "Compensation rate (sum / 5m)",
      "id": 4,
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "targets": [
        {"expr": "sum(rate(saga_compensation_total[5m]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    },
    {
      "type": "timeseries",
      "title": "Saga outcomes over time",
      "id": 5,
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 6},
      "targets": [
        {"expr": "sum by (outcome) (rate(saga_completed_total[1m]))", "refId": "A", "legendFormat": "{{outcome}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    },
    {
      "type": "timeseries",
      "title": "Compensation triggers",
      "id": 6,
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 6},
      "targets": [
        {"expr": "sum by (trigger) (rate(saga_compensation_total[1m]))", "refId": "A", "legendFormat": "{{trigger}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    },
    {
      "type": "timeseries",
      "title": "HTTP latency on order-service (p50 / p95 / p99)",
      "id": 7,
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 15},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{instance_port=\"8081\"}[5m])))", "refId": "p50", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{instance_port=\"8081\"}[5m])))", "refId": "p95", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{instance_port=\"8081\"}[5m])))", "refId": "p99", "legendFormat": "p99"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    }
  ]
}
