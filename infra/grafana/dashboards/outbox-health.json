{
  "uid": "outbox-arena-outbox-health",
  "title": "outbox-arena -- Outbox Health",
  "tags": ["outbox-arena", "outbox"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "type": "stat",
      "title": "Unpublished backlog (all services)",
      "id": 1,
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0},
      "targets": [
        {"expr": "sum(outbox_unpublished_count)", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "type": "stat",
      "title": "Publish rate (rows/sec, all services, 5m)",
      "id": 2,
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 0},
      "targets": [
        {"expr": "sum(rate(outbox_publish_total[5m]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    },
    {
      "type": "stat",
      "title": "Poller failure rate (5m)",
      "id": 3,
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 0},
      "targets": [
        {"expr": "sum(rate(outbox_poller_failures_total[5m]))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.05}, {"color": "red", "value": 0.5}]}}}
    },
    {
      "type": "timeseries",
      "title": "Unpublished backlog by service",
      "id": 4,
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 6},
      "targets": [
        {"expr": "outbox_unpublished_count", "refId": "A", "legendFormat": "{{instance_port}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "type": "timeseries",
      "title": "Publish throughput by service",
      "id": 5,
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 6},
      "targets": [
        {"expr": "rate(outbox_publish_total[1m])", "refId": "A", "legendFormat": "{{instance_port}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    },
    {
      "type": "timeseries",
      "title": "Sweep duration p99 by service",
      "id": 6,
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 15},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum by (le, instance_port) (rate(outbox_poller_sweep_duration_seconds_bucket[5m])))", "refId": "A", "legendFormat": "{{instance_port}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    }
  ]
}
